---
import CTASection from "@/components/public/CTASection.astro";
import type { LocaleCode } from "@/i18n/config";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const isCN = locale === "zh-CN";

const copy = isCN
  ? {
      eyebrow: "多端登录 · 实时同步",
      titleLines: ["一部手机", "管理所有电脑上的 Agent"],
      description:
        "Grix 支持 iPhone、Android、macOS、Linux 和 Windows 多端登录。你可以把多台电脑上的 Claude、Codex 等 Agent 拉入统一对话，数据实时同步，工作从任何设备无缝衔接。",
      primaryCta: "开始使用",
      secondaryCta: "了解移动控制",
      secondaryHref: "/zh-CN/mobile-agents",
      liveSync: "实时同步中",
      phoneTitle: "手机集中管理",
      phoneSubtitle: "统一控制多个 PC Agent",
      platforms: ["iPhone", "Android", "macOS", "Linux", "Windows"],
      pcAgents: [
        ["MacBook Pro", "Claude", "方案复核"],
        ["Linux Workstation", "Codex", "后端开发"],
        ["Windows Desktop", "Codex", "测试修复"],
        ["Mac mini", "Claude", "文档整理"]
      ],
      proof: [
        ["跨端登录", "同一个 Grix 账号可在手机、桌面和多台电脑上使用。"],
        ["实时同步", "消息、任务状态、Agent 汇报和决策在多端即时更新。"],
        ["集中控制", "一个手机端可以管理多台 PC 上运行的多个 Agent。"]
      ],
      featuresTitle: "多端办公不再割裂",
      featuresDesc:
        "当 Agent 分布在不同电脑、不同系统和不同工具里时，Grix 把它们收回到一个可观察、可操作、可协作的工作空间。",
      features: [
        ["iPhone 与 Android 随身管理", "离开桌面后，仍然能查看 Agent 进度、回复升级、调整方向和邀请协作者。"],
        ["macOS、Linux、Windows 多机部署", "把不同电脑上的 Claude、Codex 或其他 Agent 接入 Grix，保持各自运行环境和项目上下文。"],
        ["统一对话管理", "多个 PC Agent 可以进入同一个项目会话，围绕同一目标汇报、交接和协作。"],
        ["无缝衔接上下文", "手机、桌面和浏览器里的消息与状态实时同步，切换设备时不用重新解释任务。"]
      ],
      architectureTitle: "一个手机端，控制无数个 PC Agent",
      architecture: [
        ["1", "多台电脑运行 Agent", "Claude、Codex 可以分布在办公室电脑、家里主机、云端 Linux 机器或 Windows 工作站。"],
        ["2", "Grix 统一拉入会话", "每个 Agent 以成员身份进入项目对话，和人类协作者共享同一个工作上下文。"],
        ["3", "手机集中查看与决策", "你在手机上接收汇报、批准关键动作、调整任务优先级或直接接管会话。"],
        ["4", "结果同步回各端", "你的决定回到对应电脑上的 Agent，任务继续执行，所有设备看到同一份最新状态。"]
      ],
      scenariosTitle: "典型使用方式",
      scenarios: [
        ["多电脑开发", "Mac 上跑 Claude 做评审，Linux 上跑 Codex 写后端，Windows 上跑测试，手机统一看进度。"],
        ["远程办公", "离开办公桌后，手机继续处理 Agent 阻塞和同事协作，不打断电脑端任务。"],
        ["团队协作", "把同事和多个 Agent 放进同一项目会话，一起讨论、验收和推进。"],
        ["长期任务管理", "多个 PC 持续执行不同子任务，Grix 负责集中同步、提醒和升级。"]
      ]
    }
  : {
      eyebrow: "Multi-device login · live sync",
      titleLines: ["One phone", "for every agent on every computer"],
      description:
        "Grix works across iPhone, Android, macOS, Linux, and Windows. Bring Claude, Codex, and other agents from multiple computers into one conversation, with live data sync and seamless handoff across devices.",
      primaryCta: "Get started",
      secondaryCta: "Explore mobile control",
      secondaryHref: "/mobile-agents",
      liveSync: "Live sync active",
      phoneTitle: "Mobile command",
      phoneSubtitle: "Control agents across PCs",
      platforms: ["iPhone", "Android", "macOS", "Linux", "Windows"],
      pcAgents: [
        ["MacBook Pro", "Claude", "Review"],
        ["Linux Workstation", "Codex", "Backend"],
        ["Windows Desktop", "Codex", "Testing"],
        ["Mac mini", "Claude", "Docs"]
      ],
      proof: [
        ["Cross-device login", "Use the same Grix account across phones, desktops, and multiple computers."],
        ["Live synchronization", "Messages, task states, agent briefings, and decisions update across devices."],
        ["Centralized control", "One phone can supervise many agents running on many PCs."]
      ],
      featuresTitle: "Multi-device work without fragmentation",
      featuresDesc:
        "When agents run across different computers, operating systems, and tools, Grix brings them back into one observable and collaborative workspace.",
      features: [
        ["iPhone and Android in your pocket", "Away from the desk, keep reviewing progress, answering escalations, redirecting work, and inviting collaborators."],
        ["Deploy across macOS, Linux, and Windows", "Connect Claude, Codex, or other agents from different machines while preserving each runtime and project context."],
        ["Manage in one conversation", "Multiple PC agents can join the same project room to report, hand off, and collaborate around one goal."],
        ["Seamless context handoff", "Messages and states sync across phone, desktop, and browser so you do not re-explain the task when switching devices."]
      ],
      architectureTitle: "One phone can control countless PC agents",
      architecture: [
        ["1", "Agents run on many computers", "Claude and Codex can live on office machines, home desktops, cloud Linux hosts, or Windows workstations."],
        ["2", "Grix brings them into one room", "Each agent joins the project conversation as a member, sharing context with human collaborators."],
        ["3", "You decide from mobile", "Receive briefings, approve key actions, reprioritize work, or take over from your phone."],
        ["4", "Decisions sync back", "Your instruction returns to the right computer and all devices see the same current state."]
      ],
      scenariosTitle: "How teams use it",
      scenarios: [
        ["Multi-computer development", "Claude reviews on a Mac, Codex writes backend code on Linux, tests run on Windows, and your phone shows the full picture."],
        ["Remote work", "Handle agent blockers and teammate collaboration from mobile while desktop jobs keep running."],
        ["Team delivery", "Put coworkers and multiple agents in one project room to discuss, review, and ship together."],
        ["Long-running tasks", "Many PCs keep executing separate workstreams while Grix centralizes sync, reminders, and escalations."]
      ]
    };

---

<section class="device-hero -mx-4 -mt-8 px-4 pb-12 pt-14 md:-mx-6 md:-mt-12 md:px-8 md:pb-16 md:pt-24">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1fr]">
    <div class="device-hero__copy">
      <span class="device-kicker">{copy.eyebrow}</span>
      <h1 class="font-display mt-5 text-[2.7rem] leading-[1.06] text-ink sm:text-6xl lg:text-[4.7rem]">
        {copy.titleLines.map((line) => <span>{line}</span>)}
      </h1>
      <p class="mt-6 max-w-2xl text-[18px] leading-[1.62] text-ash">{copy.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#download" class="btn-ink">{copy.primaryCta}</a>
        <a href={copy.secondaryHref} class="btn-text">{copy.secondaryCta}<span aria-hidden="true">-></span></a>
      </div>
    </div>

    <div class="device-network" aria-label={isCN ? "Grix 多端同步示意" : "Grix multi-device sync diagram"}>
      <div class="device-network__phone">
        <span>{copy.phoneTitle}</span>
        <strong>{copy.phoneSubtitle}</strong>
        <small>{copy.liveSync}</small>
      </div>
      <div class="device-network__platforms">
        {copy.platforms.map((platform) => <span>{platform}</span>)}
      </div>
      <div class="device-network__agents">
        {copy.pcAgents.map(([machine, agent, status]) => (
          <article>
            <img src={agent === "Claude" ? "/assets/agents/anthropic.svg" : "/assets/agents/openai.svg"} alt={agent} />
            <div>
              <strong>{machine}</strong>
              <span>{agent} · {status}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="device-proof" aria-label={isCN ? "多端能力摘要" : "Multi-device capability summary"}>
  {copy.proof.map(([title, desc]) => (
    <div>
      <strong>{title}</strong>
      <span>{desc}</span>
    </div>
  ))}
</section>

<section id="features" class="device-section">
  <div class="device-section__intro">
    <span class="section-kicker">{isCN ? "多端协同" : "MULTI-DEVICE WORK"}</span>
    <h2 class="font-display">{copy.featuresTitle}</h2>
    <p>{copy.featuresDesc}</p>
  </div>
  <div class="device-feature-grid">
    {copy.features.map(([title, desc]) => (
      <article>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<section id="use-cases" class="device-flow">
  <div class="device-section__intro">
    <span class="section-kicker">{isCN ? "集中管理" : "CENTRAL CONTROL"}</span>
    <h2 class="font-display">{copy.architectureTitle}</h2>
  </div>
  <div class="device-flow__steps">
    {copy.architecture.map(([num, title, desc]) => (
      <article>
        <span>{num}</span>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<section class="device-scenarios">
  <div class="device-section__intro">
    <span class="section-kicker">{isCN ? "使用场景" : "SCENARIOS"}</span>
    <h2 class="font-display">{copy.scenariosTitle}</h2>
  </div>
  <div class="device-scenarios__grid">
    {copy.scenarios.map(([title, desc]) => (
      <article>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<CTASection
  title=""
  description=""
  buttonText=""
  href=""
  locale={locale}
/>

<style>
  .device-hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  .device-hero::before {
    content: "";
    position: absolute;
    inset: -12% -18% auto -18%;
    z-index: -1;
    height: 72%;
    background:
      radial-gradient(48% 58% at 78% 18%, rgba(230, 57, 70, 0.15), transparent 62%),
      radial-gradient(54% 62% at 14% 22%, rgba(255, 224, 204, 0.72), transparent 68%),
      linear-gradient(180deg, rgba(255, 252, 245, 0.94), rgba(253, 249, 239, 0));
  }

  .device-hero__copy,
  .device-network {
    min-width: 0;
  }

  .device-hero h1 span {
    display: block;
  }

  .device-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    padding: 0.45rem 0.85rem;
    color: var(--red-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .device-kicker::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--red);
  }

  .device-network {
    position: relative;
    display: grid;
    gap: 1rem;
    border: 1px solid rgba(42, 34, 20, 0.08);
    border-radius: 1.6rem;
    background: rgba(255, 252, 245, 0.86);
    padding: 1rem;
    box-shadow: 0 30px 65px -42px rgba(42, 34, 20, 0.65);
  }

  .device-network__phone {
    display: grid;
    gap: 0.35rem;
    border-radius: 1.25rem;
    background: #2a2214;
    color: #fffdf8;
    padding: 1.15rem;
  }

  .device-network__phone span,
  .device-network__phone small {
    color: #d8cbb5;
    font-size: 0.78rem;
  }

  .device-network__phone strong {
    font-size: 1.4rem;
    line-height: 1.15;
  }

  .device-network__phone small {
    color: #a7e0c1;
    font-weight: 700;
  }

  .device-network__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .device-network__platforms span {
    border: 1px solid var(--divider);
    border-radius: 999px;
    background: #fff;
    padding: 0.5rem 0.75rem;
    color: var(--ash);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .device-network__agents {
    display: grid;
    gap: 0.65rem;
  }

  .device-network__agents article {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgba(42, 34, 20, 0.08);
    border-radius: 1rem;
    background: #fff;
    padding: 0.82rem;
  }

  .device-network__agents img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: var(--fog);
    padding: 0.28rem;
  }

  .device-network__agents strong,
  .device-network__agents span {
    display: block;
  }

  .device-network__agents strong {
    color: var(--ink);
    font-size: 0.92rem;
  }

  .device-network__agents span {
    margin-top: 0.18rem;
    color: var(--ash);
    font-size: 0.78rem;
  }

  .device-proof,
  .device-feature-grid,
  .device-scenarios__grid {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--divider);
    box-shadow: 0 16px 36px -30px rgba(74, 55, 20, 0.65);
  }

  .device-proof > div,
  .device-feature-grid article,
  .device-scenarios__grid article,
  .device-flow__steps article {
    background: var(--card);
    padding: 1.15rem;
  }

  .device-proof strong,
  .device-feature-grid strong,
  .device-scenarios__grid strong,
  .device-flow__steps strong {
    display: block;
    color: var(--ink);
    font-size: 1rem;
  }

  .device-proof span,
  .device-feature-grid p,
  .device-scenarios__grid p,
  .device-flow__steps p {
    margin-top: 0.45rem;
    color: var(--ash);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .device-section,
  .device-flow,
  .device-scenarios {
    padding: 1rem 0.25rem;
  }

  .device-section__intro {
    max-width: 43rem;
    margin-bottom: 1.6rem;
  }

  .device-section__intro h2 {
    margin-top: 0.65rem;
    color: var(--ink);
    font-size: clamp(2.15rem, 5vw, 3.6rem);
    line-height: 1.08;
  }

  .device-section__intro p {
    margin-top: 1rem;
    max-width: 43rem;
    color: var(--ash);
    font-size: 1rem;
    line-height: 1.7;
  }

  .device-flow__steps {
    display: grid;
    gap: 0.75rem;
  }

  .device-flow__steps article {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    align-items: start;
    column-gap: 0.95rem;
    border-top: 1px solid var(--divider);
  }

  .device-flow__steps article > span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .device-flow__steps strong,
  .device-flow__steps p {
    grid-column: 2;
  }

  @media (min-width: 768px) {
    .device-proof {
      grid-template-columns: repeat(3, 1fr);
    }

    .device-feature-grid,
    .device-scenarios__grid,
    .device-flow__steps {
      grid-template-columns: repeat(4, 1fr);
    }

    .device-flow__steps {
      gap: 1px;
      overflow: hidden;
      border-radius: 1.25rem;
      background: var(--divider);
    }

    .device-flow__steps article {
      display: block;
      border-top: 0;
    }

    .device-flow__steps strong {
      margin-top: 1rem;
    }

  }

  @media (max-width: 767px) {
    .device-hero h1 {
      font-size: 2.3rem;
      line-height: 1.08;
    }

    .device-proof,
    .device-feature-grid,
    .device-scenarios__grid {
      border-radius: 1rem;
    }
  }
</style>
