---
import type { PageLocaleContent } from "@/lib/content-mapper/types";

interface Props {
  page: PageLocaleContent;
}

const { page } = Astro.props;
---

<article class="rounded-panel border border-slate-200 bg-white p-8">
  <h1 class="text-2xl font-semibold text-slate-900">{page.title}</h1>
  <p class="mt-4 whitespace-pre-line text-sm leading-7 text-slate-700">{page.description}</p>
</article>
