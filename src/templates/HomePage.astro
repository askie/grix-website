---
import AgentLogoWall from "@/components/public/AgentLogoWall.astro";
import FAQSection from "@/components/public/FAQSection.astro";
import FeatureGrid from "@/components/public/FeatureGrid.astro";
import Hero from "@/components/public/Hero.astro";
import HowItWorks from "@/components/public/HowItWorks.astro";
import UseCases from "@/components/public/UseCases.astro";
import type { LocaleCode } from "@/i18n/config";
import { resolveProductEntryUrls } from "@/lib/cta/product-url";
import type { PageLocaleContent } from "@/lib/content-mapper/types";

interface Props {
  locale: LocaleCode;
  page: PageLocaleContent;
}

const { locale, page } = Astro.props;
const hero = page.sections.find((s) => s.type === "hero");
const featuresSection = page.sections.find((s) => s.type === "features");
const useCasesSection = page.sections.find((s) => s.type === "use_cases");
const howItWorksSection = page.sections.find((s) => s.type === "how_it_works");
const faqSection = page.sections.find((s) => s.type === "faq");
const productUrls = resolveProductEntryUrls();

// 将 "icon｜title｜desc" 格式的 item 字符串解析为结构化对象
function parseIconItems(items: string[] = []) {
  return items.map((item) => {
    const sep = "｜";
    const idx = item.indexOf(sep);
    if (idx === -1) return { icon: "", title: item, desc: "" };
    const iconTitle = item.slice(0, idx);
    const desc = item.slice(idx + sep.length);
    // iconTitle 格式为 "🤖 标题文字"
    const spaceIdx = iconTitle.indexOf(" ");
    const icon = spaceIdx !== -1 ? iconTitle.slice(0, spaceIdx) : "";
    const title = spaceIdx !== -1 ? iconTitle.slice(spaceIdx + 1) : iconTitle;
    return { icon, title, desc };
  });
}

// 解析 FAQ items："问题｜答案"
function parseFAQItems(items: string[] = []) {
  return items.map((item) => {
    const sep = "｜";
    const idx = item.indexOf(sep);
    if (idx === -1) return { q: item, a: "" };
    return { q: item.slice(0, idx), a: item.slice(idx + sep.length) };
  });
}

const featureItems = parseIconItems(featuresSection?.items);
const useCaseItems = parseIconItems(useCasesSection?.items);
const faqItems = parseFAQItems(faqSection?.items);
---

<Hero
  heading={hero?.title ?? page.title}
  description={hero?.content ?? page.description}
  ctaLabel={page.ctaPrimaryText}
  globalHref={productUrls.global}
  cnHref={productUrls.cn}
  locale={locale}
/>

{locale === "en" && (
  <section class="proof-strip" aria-label="Grix product promise">
    <div><strong>One goal in.</strong><span>A self-organizing team gets to work.</span></div>
    <div><strong>16 agent families.</strong><span>One growing organization.</span></div>
    <div><strong>Human judgment stays yours.</strong><span>Agents escalate, you decide.</span></div>
  </section>
)}

<AgentLogoWall
  heading={locale === "zh-CN" ? "已支持的 AI Agent" : "Supported AI Agents"}
  description={
    locale === "zh-CN"
      ? "Claude、Codex、Gemini、Copilot、Qwen 等主流 Agent 都能接入同一个会话，各司其职、并行协作。"
      : "Claude, Codex, Gemini, Copilot, Qwen and more — all join the same conversation to collaborate in parallel, each on its own task."
  }
/>

{locale === "en" && (
  <section class="story-grid">
    <div class="story-grid__intro">
      <span class="section-kicker">THE OPERATING LOOP</span>
      <h2 class="font-display text-[2.25rem] leading-[1.08] text-ink md:text-5xl">Stop coordinating every thread.</h2>
      <p>Grix gives your agents the structure to coordinate themselves — and gives you a clear place to step in when a decision is actually yours.</p>
    </div>
    <div class="story-grid__steps">
      <div><span>01</span><div><strong>Give a goal</strong><p>Tell one manager agent what outcome you need.</p></div></div>
      <div><span>02</span><div><strong>Let it organize</strong><p>It creates roles, finds the right agents, and opens the workspace.</p></div></div>
      <div><span>03</span><div><strong>Stay in the loop</strong><p>See the work, get a briefing, and take over whenever you choose.</p></div></div>
    </div>
  </section>
)}

{
  featuresSection && featureItems.length > 0 && (
    <FeatureGrid
      title={featuresSection.title}
      description={featuresSection.content}
      items={featureItems}
    />
  )
}

{
  useCasesSection && useCaseItems.length > 0 && (
    <UseCases
      title={useCasesSection.title}
      description={useCasesSection.content}
      items={useCaseItems}
    />
  )
}

{
  howItWorksSection && howItWorksSection.items && howItWorksSection.items.length > 0 && (
    <HowItWorks
      title={howItWorksSection.title}
      description={howItWorksSection.content}
      steps={howItWorksSection.items}
    />
  )
}

{
  faqSection && faqItems.length > 0 && (
    <FAQSection title={faqSection.title} items={faqItems} />
  )
}
