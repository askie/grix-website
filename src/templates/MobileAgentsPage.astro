---
import type { LocaleCode } from "@/i18n/config";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const isCN = locale === "zh-CN";

const copy = isCN
  ? {
      eyebrow: "移动端 Agent 控制台",
      title: "在手机上指挥 Claude 和 Codex 协作开发",
      description:
        "Grix 把 Claude、Codex 和你的其他 Agent 放进同一个移动协作空间。离开电脑后，你仍然可以查看进度、授权操作、回复阻塞，并邀请朋友或同事一起推进开发。",
      primaryCta: "打开 Grix",
      secondaryCta: "查看用户手册",
      secondaryHref: "/zh-CN/docs",
      promise: "移动端发起、监督和接管 Agent 工作",
      phoneTitle: "移动工作台",
      phoneStatus: "3 个 Agent 正在协作",
      command: "让 Codex 修复登录回归，并请 Claude 复核交互文案",
      invite: "邀请同事加入评审",
      handoff: "阻塞已升级给你",
      proof: [
        ["手机即控制台", "随时查看 Claude、Codex 与其他 Agent 的任务状态。"],
        ["协作空间可邀请", "把朋友、同事和 Agent 拉进同一个项目会话。"],
        ["电脑继续执行", "你在手机上决策，桌面端 Agent 保持上下文继续工作。"]
      ],
      featuresTitle: "为移动端办公而设计的 Agent 操作方式",
      featuresDesc:
        "Grix 不是把网页塞进手机，而是把 Agent 的委派、授权、汇报和协作变成适合移动场景的工作流。",
      features: [
        ["远程发指令", "在通勤、会议间隙或离开电脑时，直接给 Claude、Codex 或主管 Agent 分派目标。"],
        ["实时看进度", "群组、消息、任务状态和阻塞都在 IM 中可见，不需要翻多个终端和浏览器标签。"],
        ["关键点再打断", "Agent 只在需要你判断、授权或补充上下文时升级，手机上处理后回到原会话继续。"],
        ["随时接管", "看到风险、方向偏差或测试失败时，可以暂停、改写要求或亲自进入会话。"]
      ],
      workflowTitle: "Claude + Codex 的移动协作循环",
      workflow: [
        ["1", "提出目标", "你在手机上说清楚结果，例如修复一个 bug、补一个页面或准备一次发布。"],
        ["2", "分配角色", "Grix 让 Codex 负责代码改动，让 Claude 做方案、文案、复核或问题拆解。"],
        ["3", "多人加入", "把朋友或同事邀请进项目会话，一起看 Agent 进度、讨论取舍、确认验收。"],
        ["4", "手机决策", "需要授权、合并、改方向或补充信息时，Grix 把摘要带给你。"],
        ["5", "回到执行", "你的决定被送回对应 Agent 会话，工作继续推进，电脑端上下文不丢失。"]
      ],
      collaborationTitle: "邀请朋友和同事一起开发",
      collaborationDesc:
        "项目协作不只发生在代码仓库。Grix 让人和 Agent 共享同一个可观察空间，适合结对开发、远程评审、快速原型和小团队交付。",
      collaboration: [
        ["共享项目会话", "围绕一个目标建立会话，成员能看到 Agent 的消息、结论和下一步。"],
        ["按角色协作", "同事可以负责产品判断、测试验收或代码复核，Agent 负责并行执行。"],
        ["授权范围清晰", "只让 Agent 观察和操作你明确授权的会话，关键动作先向你升级。"]
      ],
      scenariosTitle: "适合这些移动端场景",
      scenarios: [
        ["外出时跟进开发", "Codex 继续改代码，你在手机上看摘要、调整优先级。"],
        ["快速拉人评审", "把同事邀请进会话，请 Claude 解释变更影响并收集反馈。"],
        ["发布前巡检", "让 Agent 汇总代码、测试、文档和风险，你只处理需要判断的项。"],
        ["客户现场响应", "把问题转给 Agent 排查，同时和团队在同一会话里同步进展。"]
      ],
      ctaTitle: "把手机变成你的 Agent 指挥台",
      ctaDesc: "用 Grix 控制 Claude、Codex 和你的协作团队，让开发工作在桌面端执行，在移动端被你掌握。"
    }
  : {
      eyebrow: "Mobile agent control",
      title: "Run Claude and Codex from your phone",
      description:
        "Grix puts Claude, Codex, and your other agents into one mobile collaboration space. Away from your desk, you can still inspect progress, approve actions, unblock work, and invite friends or teammates to build with you.",
      primaryCta: "Open Grix",
      secondaryCta: "Read the guide",
      secondaryHref: "/docs",
      promise: "Start, supervise, and take over agent work from mobile",
      phoneTitle: "Mobile workspace",
      phoneStatus: "3 agents collaborating",
      command: "Ask Codex to fix the login regression and have Claude review the interaction copy",
      invite: "Invite teammate to review",
      handoff: "Blocker escalated to you",
      proof: [
        ["Phone as control room", "Track Claude, Codex, and other agents wherever you are."],
        ["Invite collaborators", "Bring friends, teammates, and agents into the same project conversation."],
        ["Desktop keeps running", "Decide on mobile while desktop agents continue with full context."]
      ],
      featuresTitle: "Agent operations designed for mobile work",
      featuresDesc:
        "Grix is not a desktop webpage squeezed onto a phone. It turns delegation, approvals, briefings, and collaboration into mobile-native agent workflows.",
      features: [
        ["Command remotely", "Assign outcomes to Claude, Codex, or a manager agent during a commute, meeting break, or while away from your desk."],
        ["Watch live progress", "Groups, messages, task states, and blockers stay visible in IM instead of scattered across terminals and browser tabs."],
        ["Interrupt only when needed", "Agents escalate when they need judgment, approval, or missing context, then continue in the original conversation."],
        ["Take over anytime", "Pause, redirect, or enter the conversation when you see risk, drift, or failing tests."]
      ],
      workflowTitle: "The Claude + Codex mobile loop",
      workflow: [
        ["1", "Set the goal", "Describe the outcome from your phone, such as fixing a bug, adding a page, or preparing a release."],
        ["2", "Assign roles", "Grix lets Codex handle code while Claude supports planning, copy, review, or problem breakdown."],
        ["3", "Bring people in", "Invite friends or teammates into the project conversation to discuss tradeoffs and confirm acceptance."],
        ["4", "Decide on mobile", "When authorization, merge judgment, direction change, or context is needed, Grix brings you the brief."],
        ["5", "Return to execution", "Your decision goes back to the right agent conversation and desktop context stays intact."]
      ],
      collaborationTitle: "Invite friends and coworkers to build together",
      collaborationDesc:
        "Project work is bigger than a repository. Grix gives humans and agents one observable space for pair building, remote review, rapid prototyping, and small-team delivery.",
      collaboration: [
        ["Shared project rooms", "Create a conversation around one outcome so members can see agent messages, conclusions, and next steps."],
        ["Role-based teamwork", "Teammates handle product judgment, QA, or code review while agents execute in parallel."],
        ["Clear permissions", "Agents observe and operate only inside conversations you authorize, with key actions escalated first."]
      ],
      scenariosTitle: "Built for mobile moments",
      scenarios: [
        ["Follow development outside", "Codex keeps coding while you review summaries and reprioritize from your phone."],
        ["Pull in a reviewer fast", "Invite a teammate and ask Claude to explain impact while collecting feedback."],
        ["Pre-release checks", "Have agents summarize code, tests, docs, and risk so you only handle judgment calls."],
        ["Respond on-site", "Send an issue to agents for diagnosis while keeping the team synced in one conversation."]
      ],
      ctaTitle: "Turn your phone into an agent command center",
      ctaDesc: "Use Grix to control Claude, Codex, and your collaborators while development runs on the desktop and stays under your judgment."
    };

const appUrl = "https://grix.im";
const titleLines = isCN ? ["在手机上指挥", "Claude 和 Codex", "协作开发"] : ["Run Claude and Codex", "from your phone"];
---

<section class="mobile-hero -mx-4 -mt-8 px-4 pb-12 pt-14 md:-mx-6 md:-mt-12 md:px-8 md:pb-16 md:pt-24">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.02fr_.98fr]">
    <div class="mobile-hero__copy">
      <span class="mobile-kicker">{copy.eyebrow}</span>
      <h1 class="font-display mt-5 text-[2.85rem] leading-[1.06] text-ink sm:text-6xl lg:text-[4.85rem]">
        {titleLines.map((line) => <span>{line}</span>)}
      </h1>
      <p class="mt-6 max-w-2xl text-[18px] leading-[1.62] text-ash">{copy.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={appUrl} target="_blank" rel="noopener noreferrer" class="btn-ink">{copy.primaryCta}</a>
        <a href={copy.secondaryHref} class="btn-text">{copy.secondaryCta}<span aria-hidden="true">-></span></a>
      </div>
      <p class="mt-5 text-[13px] font-medium text-ash">{copy.promise}</p>
    </div>

    <div class="mobile-console" aria-label={copy.phoneTitle}>
      <div class="mobile-console__phone">
        <div class="mobile-console__screen">
          <div class="mobile-console__topbar">
            <span>{copy.phoneTitle}</span>
            <strong>{copy.phoneStatus}</strong>
          </div>
          <div class="mobile-console__command">
            <small>{isCN ? "目标" : "Goal"}</small>
            <p>{copy.command}</p>
          </div>
          <div class="mobile-console__agents">
            <div>
              <img src="/assets/agents/openai.svg" alt="OpenAI" />
              <span>Codex</span>
              <strong>{isCN ? "改代码" : "Coding"}</strong>
            </div>
            <div>
              <img src="/assets/agents/anthropic.svg" alt="Anthropic" />
              <span>Claude</span>
              <strong>{isCN ? "复核" : "Review"}</strong>
            </div>
            <div>
              <img src="/assets/brand/app_logo.png" alt="Grix" />
              <span>Grix</span>
              <strong>{isCN ? "协调" : "Coordination"}</strong>
            </div>
          </div>
          <div class="mobile-console__event mobile-console__event--active">
            <span>{isCN ? "协作" : "Collab"}</span>
            <p>{copy.invite}</p>
          </div>
          <div class="mobile-console__event">
            <span>{isCN ? "需要你" : "Needs you"}</span>
            <p>{copy.handoff}</p>
          </div>
        </div>
      </div>
      <div class="mobile-console__dock">
        <video
          controls
          preload="metadata"
          playsinline
          webkit-playsinline
          aria-label={isCN ? "Grix 手机端操作演示" : "Grix mobile workflow demo"}
        >
          <source src="/assets/videos/grix-work-debug-phone.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<section class="mobile-proof" aria-label={isCN ? "移动端能力摘要" : "Mobile capability summary"}>
  {copy.proof.map(([title, desc]) => (
    <div>
      <strong>{title}</strong>
      <span>{desc}</span>
    </div>
  ))}
</section>

<section id="features" class="mobile-section">
  <div class="mobile-section__intro">
    <span class="section-kicker">{isCN ? "移动控制" : "MOBILE CONTROL"}</span>
    <h2 class="font-display">{copy.featuresTitle}</h2>
    <p>{copy.featuresDesc}</p>
  </div>
  <div class="mobile-feature-grid">
    {copy.features.map(([title, desc]) => (
      <article>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<section id="use-cases" class="mobile-workflow">
  <div class="mobile-section__intro">
    <span class="section-kicker">{isCN ? "工作循环" : "OPERATING LOOP"}</span>
    <h2 class="font-display">{copy.workflowTitle}</h2>
  </div>
  <div class="mobile-workflow__steps">
    {copy.workflow.map(([num, title, desc]) => (
      <div>
        <span>{num}</span>
        <strong>{title}</strong>
        <p>{desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="mobile-collab">
  <div>
    <span class="section-kicker">{isCN ? "团队协作" : "TEAM COLLABORATION"}</span>
    <h2 class="font-display">{copy.collaborationTitle}</h2>
    <p>{copy.collaborationDesc}</p>
  </div>
  <div class="mobile-collab__cards">
    {copy.collaboration.map(([title, desc]) => (
      <article>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<section class="mobile-scenarios">
  <div class="mobile-section__intro">
    <span class="section-kicker">{isCN ? "典型场景" : "SCENARIOS"}</span>
    <h2 class="font-display">{copy.scenariosTitle}</h2>
  </div>
  <div class="mobile-scenarios__grid">
    {copy.scenarios.map(([title, desc]) => (
      <article>
        <strong>{title}</strong>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>

<section id="download" class="mobile-cta">
  <div>
    <span class="section-kicker">{isCN ? "开始使用" : "GET STARTED"}</span>
    <h2 class="font-display">{copy.ctaTitle}</h2>
    <p>{copy.ctaDesc}</p>
    <a href={appUrl} target="_blank" rel="noopener noreferrer" class="btn-ink">{copy.primaryCta}</a>
  </div>
  <div class="mobile-qr" aria-label={isCN ? "Grix 下载二维码" : "Grix download QR codes"}>
    <div>
      <img src="/qr/ios.svg" alt="iOS QR code" />
      <span>iOS</span>
    </div>
    <div>
      <img src="/qr/android.svg" alt="Android QR code" />
      <span>Android</span>
    </div>
  </div>
</section>

<style>
  .mobile-hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  .mobile-hero::before {
    content: "";
    position: absolute;
    inset: -10% -18% auto -18%;
    z-index: -1;
    height: 72%;
    background:
      radial-gradient(54% 62% at 78% 18%, rgba(230, 57, 70, 0.16), transparent 62%),
      radial-gradient(50% 58% at 15% 28%, rgba(255, 224, 204, 0.74), transparent 66%),
      linear-gradient(180deg, rgba(255, 252, 245, 0.92), rgba(253, 249, 239, 0));
  }

  .mobile-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    padding: 0.45rem 0.85rem;
    color: var(--red-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .mobile-kicker::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--red);
  }

  .mobile-hero__copy,
  .mobile-console {
    min-width: 0;
  }

  .mobile-hero h1 {
    overflow-wrap: anywhere;
  }

  .mobile-hero h1 span {
    display: block;
  }

  .mobile-console {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 35rem;
  }

  .mobile-console__phone {
    width: min(100%, 24rem);
    border-radius: 2.1rem;
    background: #2a2214;
    padding: 0.72rem;
    box-shadow: 0 34px 70px -38px rgba(42, 34, 20, 0.7);
  }

  .mobile-console__screen {
    min-height: 34rem;
    border-radius: 1.55rem;
    background: #fffdf8;
    padding: 1rem;
    overflow: hidden;
  }

  .mobile-console__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ash);
    font-size: 0.74rem;
  }

  .mobile-console__topbar strong {
    color: #35a66f;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .mobile-console__command {
    margin-top: 1.25rem;
    border: 1px solid rgba(42, 34, 20, 0.08);
    border-radius: 1rem;
    background: var(--fog);
    padding: 1rem;
  }

  .mobile-console__command small,
  .mobile-console__event span {
    color: var(--red-dark);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mobile-console__command p {
    margin-top: 0.45rem;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .mobile-console__agents {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .mobile-console__agents > div,
  .mobile-console__event {
    border: 1px solid rgba(42, 34, 20, 0.08);
    border-radius: 1rem;
    background: #ffffff;
    padding: 0.82rem;
  }

  .mobile-console__agents > div {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .mobile-console__agents img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: var(--fog);
    padding: 0.28rem;
  }

  .mobile-console__agents span {
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .mobile-console__agents strong {
    color: var(--ash);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .mobile-console__event {
    margin-top: 0.75rem;
  }

  .mobile-console__event--active {
    background: #2a2214;
  }

  .mobile-console__event p {
    margin-top: 0.35rem;
    color: var(--ash);
    font-size: 0.86rem;
  }

  .mobile-console__event--active p {
    color: #fffdf8;
  }

  .mobile-console__dock {
    position: absolute;
    right: 0;
    bottom: 1.5rem;
    width: 12rem;
    overflow: hidden;
    border: 0.5rem solid #2a2214;
    border-radius: 1.25rem;
    background: #2a2214;
    box-shadow: 0 24px 50px -28px rgba(42, 34, 20, 0.7);
  }

  .mobile-console__dock video {
    display: block;
    width: 100%;
    aspect-ratio: 592 / 1280;
    object-fit: cover;
    object-position: top;
    background: #000;
  }

  .mobile-proof,
  .mobile-feature-grid,
  .mobile-collab__cards,
  .mobile-scenarios__grid {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--divider);
    box-shadow: 0 16px 36px -30px rgba(74, 55, 20, 0.65);
  }

  .mobile-proof > div,
  .mobile-feature-grid article,
  .mobile-collab__cards article,
  .mobile-scenarios__grid article {
    background: var(--card);
    padding: 1.15rem;
  }

  .mobile-proof strong,
  .mobile-feature-grid strong,
  .mobile-collab__cards strong,
  .mobile-scenarios__grid strong,
  .mobile-workflow__steps strong {
    display: block;
    color: var(--ink);
    font-size: 1rem;
  }

  .mobile-proof span,
  .mobile-feature-grid p,
  .mobile-collab p,
  .mobile-scenarios__grid p,
  .mobile-workflow__steps p,
  .mobile-cta p {
    margin-top: 0.45rem;
    color: var(--ash);
    font-size: 0.9rem;
    line-height: 1.58;
  }

  .mobile-section,
  .mobile-workflow,
  .mobile-collab,
  .mobile-scenarios,
  .mobile-cta {
    padding: 1rem 0.25rem;
  }

  .mobile-section__intro {
    max-width: 42rem;
    margin-bottom: 1.6rem;
  }

  .mobile-section__intro h2,
  .mobile-collab h2,
  .mobile-cta h2 {
    margin-top: 0.65rem;
    color: var(--ink);
    font-size: clamp(2.15rem, 5vw, 3.6rem);
    line-height: 1.08;
  }

  .mobile-section__intro p,
  .mobile-collab > div:first-child p,
  .mobile-cta > div:first-child p {
    margin-top: 1rem;
    max-width: 42rem;
    color: var(--ash);
    font-size: 1rem;
    line-height: 1.7;
  }

  .mobile-workflow__steps {
    display: grid;
    gap: 0.75rem;
  }

  .mobile-workflow__steps > div {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    align-items: start;
    column-gap: 0.95rem;
    border-top: 1px solid var(--divider);
    padding: 1rem 0.25rem 0.25rem;
  }

  .mobile-workflow__steps > div > span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .mobile-workflow__steps strong,
  .mobile-workflow__steps p {
    grid-column: 2;
  }

  .mobile-collab {
    display: grid;
    gap: 1.5rem;
  }

  .mobile-cta {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    border: 1px solid rgba(42, 34, 20, 0.08);
    border-radius: 1.5rem;
    background: var(--card);
    padding: 1.25rem;
    box-shadow: 0 20px 45px -34px rgba(42, 34, 20, 0.65);
  }

  .mobile-cta .btn-ink {
    margin-top: 1.1rem;
  }

  .mobile-qr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .mobile-qr > div {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    border: 1px solid var(--divider);
    border-radius: 1rem;
    background: #fff;
    padding: 0.8rem;
  }

  .mobile-qr img {
    width: 100%;
    max-width: 8rem;
    aspect-ratio: 1;
  }

  .mobile-qr span {
    color: var(--ash);
    font-size: 0.8rem;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .mobile-proof,
    .mobile-feature-grid,
    .mobile-scenarios__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .mobile-feature-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .mobile-collab {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3rem;
      align-items: start;
    }

    .mobile-collab__cards {
      grid-template-columns: 1fr;
    }

    .mobile-workflow__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 1px;
