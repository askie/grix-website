---
import type { PageLocaleContent } from "@/lib/content-mapper/types";

interface Props {
  page: PageLocaleContent;
}

const { page } = Astro.props;
---

<article class="rounded-panel border border-slate-200 bg-white p-8">
  <h1 class="text-3xl font-semibold text-slate-900">{page.title}</h1>
  <p class="mt-3 text-slate-600">{page.description}</p>

  <div class="mt-6 space-y-4">
    {
      page.sections.map((section) => (
        <section>
          <h2 class="text-xl font-semibold text-slate-900">{section.title}</h2>
          <p class="mt-2 text-slate-700">{section.content}</p>
          {section.items && <ul class="mt-3 list-disc pl-5 text-slate-700">{section.items.map((item) => <li>{item}</li>)}</ul>}
        </section>
      ))
    }
  </div>
</article>
