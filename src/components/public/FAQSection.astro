---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title: string;
}

const { items, title } = Astro.props;
---

<section id="faq" class="steep-card p-7 md:p-10">
  <h2 class="text-[26px] font-medium leading-tight text-ink">{title}</h2>
  <div class="mt-6 space-y-3">
    {
      items.map((item) => (
        <details class="group rounded-2xl border border-black/5 bg-white p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between text-[16px] font-medium text-ink">
            <span>{item.q}</span>
            <span class="ml-3 text-dove transition-transform group-open:rotate-180">▾</span>
          </summary>
          <p class="mt-3 border-t border-black/5 pt-3 text-[14px] leading-[1.6] text-ash">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
