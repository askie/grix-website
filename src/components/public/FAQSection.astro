---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title: string;
}

const { items, title } = Astro.props;
---

<section id="faq" class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-slate-900">{title}</h2>
  <div class="mt-5 space-y-3">
    {
      items.map((item) => (
        <details class="rounded-xl border border-slate-100 bg-slate-50 p-4 group">
          <summary class="cursor-pointer font-medium text-slate-900 list-none flex items-center justify-between">
            <span>{item.q}</span>
            <span class="ml-3 text-slate-400 group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <p class="mt-3 text-sm leading-6 text-slate-600 border-t border-slate-200 pt-3">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
