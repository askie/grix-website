---
interface Props {
  heading: string;
  description: string;
  primaryCtaLabel: string;
  secondaryCtaLabel: string;
  primaryHref: string;
  secondaryHref: string;
}

const {
  heading,
  description,
  primaryCtaLabel,
  secondaryCtaLabel,
  primaryHref,
  secondaryHref
} = Astro.props;
---

<section class="rounded-panel border border-slate-200 bg-white p-8 shadow-panel md:p-12">
  <h1 class="text-3xl font-semibold leading-tight text-slate-900 md:text-5xl">{heading}</h1>
  <p class="mt-5 max-w-3xl text-base leading-7 text-slate-600 md:text-lg">{description}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href={primaryHref} class="rounded-full bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700">
      {primaryCtaLabel}
    </a>
    <a href={secondaryHref} class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:border-brand-500 hover:text-brand-700">
      {secondaryCtaLabel}
    </a>
  </div>
</section>
