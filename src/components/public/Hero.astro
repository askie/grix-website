---
import type { LocaleCode } from "@/i18n/config";

interface Props {
  heading: string;
  description: string;
  ctaLabel: string;
  globalHref: string;
  cnHref: string;
  locale: LocaleCode;
}

const { heading, description, ctaLabel, globalHref, cnHref, locale } = Astro.props;
const isCN = locale === "zh-CN";
const eyebrow = isCN ? "人类 + AI 智能体 · 同一会话" : "Humans + AI agents · one conversation";
const cnLabel = isCN ? "中国大陆" : "China mainland";
const isEnglish = locale === "en";
const showOrganization = isEnglish || isCN;
const organizationCopy = isCN
  ? {
      aria: "主管 Agent 正在协调开发、审查和测试岗位",
      label: "你的 AI 组织",
      live: "运行中",
      goal: "目标",
      goalText: "修复结账问题",
      active: "3 个岗位工作中",
      manager: "Codex 主管",
      managerDetail: "分派任务并观察阻塞",
      dev: "开发",
      reviewer: "审查",
      qa: "测试",
      working: "工作中",
      reviewing: "审查差异",
      testing: "测试边界情况",
      footer: "只把需要你判断的事项带回来。"
    }
  : {
      aria: "A manager agent coordinating a developer, reviewer, and tester",
      label: "YOUR AI ORGANIZATION",
      live: "LIVE",
      goal: "GOAL",
      goalText: "Ship the checkout fix",
      active: "3 roles active",
      manager: "Codex Manager",
      managerDetail: "assigning work and watching blockers",
      dev: "Dev",
      reviewer: "Reviewer",
      qa: "QA",
      working: "working",
      reviewing: "reviewing diff",
      testing: "testing edge cases",
      footer: "You get the decision that needs you."
    };
---

<section class="hero-glow -mx-4 -mt-8 px-6 py-16 md:-mx-6 md:-mt-12 md:px-12 md:py-28">
  <div class:list={["mx-auto", isEnglish ? "grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_.95fr]" : "max-w-3xl"]}>
    <div>
    <span class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3.5 py-1.5 text-[13px] font-medium text-graphite ring-1 ring-black/5">
      <span class="h-1.5 w-1.5 rounded-full bg-rust"></span>
      {eyebrow}
    </span>
    <h1 class="font-display mt-6 text-[2.75rem] leading-[1.08] text-ink sm:text-6xl">
      {heading}
    </h1>
    <p class="mt-5 max-w-2xl text-[18px] leading-[1.55] text-ash">{description}</p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={globalHref} target="_blank" rel="noopener noreferrer" class="btn-ink">
        {ctaLabel}
      </a>
      <a href={cnHref} target="_blank" rel="noopener noreferrer" class="btn-text">
        {cnLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
    {isEnglish && <p class="mt-5 text-[13px] text-ash">One eligible Codex or Claude plan is enough to start.</p>}
    {isCN && <p class="mt-5 text-[13px] text-ash">一份符合条件的 Codex 或 Claude 订阅即可开始。</p>}
    </div>
    {showOrganization && (
      <div class="hero-organization" aria-label={organizationCopy.aria}>
        <div class="hero-organization__header">
          <span class="hero-organization__pulse"></span>
          <span>{organizationCopy.label}</span>
          <span class="hero-organization__live">{organizationCopy.live}</span>
        </div>
        <div class="hero-organization__goal">
          <span class="hero-organization__label">{organizationCopy.goal}</span>
          <strong>{organizationCopy.goalText}</strong>
          <span class="hero-organization__status">{organizationCopy.active}</span>
        </div>
        <div class="hero-organization__connector" aria-hidden="true"></div>
        <div class="hero-organization__manager">
          <span class="hero-organization__avatar hero-organization__avatar--manager">✦</span>
          <span><strong>{organizationCopy.manager}</strong><small>{organizationCopy.managerDetail}</small></span>
          <span class="hero-organization__check">✓</span>
        </div>
        <div class="hero-organization__roles">
          <div><span class="hero-organization__avatar">⌘</span><strong>{organizationCopy.dev}</strong><small>{organizationCopy.working}</small></div>
          <div><span class="hero-organization__avatar">◌</span><strong>{organizationCopy.reviewer}</strong><small>{organizationCopy.reviewing}</small></div>
          <div><span class="hero-organization__avatar">✓</span><strong>{organizationCopy.qa}</strong><small>{organizationCopy.testing}</small></div>
        </div>
        <div class="hero-organization__footer"><span>◎</span> {organizationCopy.footer}</div>
      </div>
    )}
  </div>
</section>
