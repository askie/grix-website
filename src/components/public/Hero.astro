---
import type { LocaleCode } from "@/i18n/config";

interface Props {
  heading: string;
  description: string;
  locale: LocaleCode;
}

const { heading, description, locale } = Astro.props;
const isCN = locale === "zh-CN";
const eyebrow = isCN ? "人类 + AI 智能体 · 同一会话" : "Humans + AI agents · one conversation";
const isEnglish = locale === "en";
---

<section class="hero-glow -mx-4 -mt-8 px-6 pb-10 pt-16 md:-mx-6 md:-mt-12 md:px-12 md:pb-14 md:pt-28">
  <div class="mx-auto grid max-w-6xl items-center gap-x-12 gap-y-20 lg:grid-cols-[1.05fr_.95fr] lg:gap-12">
    <div>
    <span class="inline-flex items-center gap-2 rounded-full bg-white/70 px-3.5 py-1.5 text-[13px] font-medium text-graphite ring-1 ring-black/5">
      <span class="h-1.5 w-1.5 rounded-full bg-rust"></span>
      {eyebrow}
    </span>
    <h1 class="font-display mt-6 text-[2.75rem] leading-[1.08] text-ink sm:text-6xl">
      {heading}
    </h1>
    <p class="mt-5 max-w-2xl text-[18px] leading-[1.55] text-ash">{description}</p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="#download" class="btn-ink">
        {isCN ? "开始使用" : "Get started"}
      </a>
    </div>
    {isEnglish && <p class="mt-5 text-[13px] text-ash">One eligible Codex or Claude plan is enough to start.</p>}
    {isCN && <p class="mt-5 text-[13px] text-ash">一份符合条件的 Codex 或 Claude 订阅即可开始。</p>}
    </div>
    <div class="flex items-center justify-center">
      {/*
        Aspect ratio lives on the SCREEN, not the outer shell. Equal padding/border
        on a fixed-AR shell warps the inner box, so the video top drifts and the
        bottom bleeds into the bezel (worse on iOS Safari video layers).
      */}
      <div
        class="hero-phone relative w-full max-w-[220px] rounded-[1.75rem] bg-ink p-2 shadow-2xl sm:max-w-[240px] sm:rounded-[2rem] sm:p-[9px] md:max-w-[260px] md:rounded-[2.25rem] md:p-2.5 lg:max-w-[280px] lg:rounded-[2.5rem]"
      >
        {/* Side buttons: translate by own width so they stay flush to the shell
            (fixed -left/-right larger than button width leaves a floating gap). */}
        <div class="absolute left-0 top-[18%] h-8 w-[3px] -translate-x-full rounded-l-md bg-ink sm:h-9 sm:w-[4px] md:h-10"></div>
        <div class="absolute left-0 top-[26%] h-14 w-[3px] -translate-x-full rounded-l-md bg-ink sm:h-[60px] sm:w-[4px] md:h-16"></div>
        <div class="absolute right-0 top-[22%] h-16 w-[3px] translate-x-full rounded-r-md bg-ink sm:h-[72px] sm:w-[4px] md:h-20"></div>

        <div
          class="hero-phone__screen relative w-full overflow-hidden rounded-[1.15rem] bg-black sm:rounded-[1.35rem] md:rounded-[1.55rem] lg:rounded-[1.75rem]"
          style="aspect-ratio: 592 / 1280;"
        >
          <video
            controls
            preload="metadata"
            playsinline
            webkit-playsinline
            class="hero-phone__video absolute inset-0 block h-full w-full object-cover object-top"
            aria-label={isCN ? "手机端 Agent 工作演示" : "Mobile agent workflow demo"}
          >
            <source src="/assets/videos/grix-work-debug-phone.mp4" type="video/mp4" />
            {isCN ? "您的浏览器不支持视频播放。" : "Your browser does not support the video tag."}
          </video>
          <div class="pointer-events-none absolute left-1/2 top-2 z-10 h-5 w-14 -translate-x-1/2 rounded-full bg-ink sm:top-3 sm:h-6 sm:w-20"></div>
        </div>

        {/* Covers any iOS video bleed into the bezel; sits above the video layer. */}
        <div class="hero-phone__bezel pointer-events-none absolute inset-0 z-20 rounded-[inherit]" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-phone__screen {
    /* clip-path + isolation: more reliable than overflow alone for iOS video */
    -webkit-clip-path: inset(0 round 1.15rem);
    clip-path: inset(0 round 1.15rem);
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(#fff, #000);
    mask-image: radial-gradient(#fff, #000);
    transform: translateZ(0);
  }

  @media (min-width: 640px) {
    .hero-phone__screen {
      -webkit-clip-path: inset(0 round 1.35rem);
      clip-path: inset(0 round 1.35rem);
    }
  }

  @media (min-width: 768px) {
    .hero-phone__screen {
      -webkit-clip-path: inset(0 round 1.55rem);
      clip-path: inset(0 round 1.55rem);
    }
  }

  @media (min-width: 1024px) {
    .hero-phone__screen {
      -webkit-clip-path: inset(0 round 1.75rem);
      clip-path: inset(0 round 1.75rem);
    }
  }

  /* Inset ring matches padding bezel (8 / 9 / 10px) and paints above <video>. */
  .hero-phone__bezel {
    box-shadow: inset 0 0 0 8px var(--ink);
  }

  @media (min-width: 640px) {
    .hero-phone__bezel {
      box-shadow: inset 0 0 0 9px var(--ink);
    }
  }

  @media (min-width: 768px) {
    .hero-phone__bezel {
      box-shadow: inset 0 0 0 10px var(--ink);
    }
  }

  .hero-phone__video {
    /* Keep video in its own layer but below the bezel mask */
    transform: translateZ(0);
  }
</style>
