---
import LanguageSwitcher from "@/components/public/LanguageSwitcher.astro";
import type { LocaleCode } from "@/i18n/config";
import { toLocalizedPath } from "@/i18n/routes";

interface Props {
  currentLocale: LocaleCode;
  currentSlug?: string;
}

const { currentLocale, currentSlug = "" } = Astro.props;
const navItems = [
  { label: currentLocale === "zh-CN" ? "能力" : "Features", href: "#features" },
  { label: currentLocale === "zh-CN" ? "场景" : "Use Cases", href: "#use-cases" },
  { label: currentLocale === "zh-CN" ? "常见问题" : "FAQ", href: "#faq" },
  { label: currentLocale === "zh-CN" ? "用户手册" : "Docs", href: currentLocale === "zh-CN" ? "/zh-CN/docs" : "/docs" }
];
---

<header class="sticky top-0 z-20 border-b border-black/5 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-shell items-center justify-between px-4 py-3.5 md:px-6">
    <a href={toLocalizedPath(currentLocale)} class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-ink">
      <img src="/assets/brand/app_logo.png" alt="Grix" width="30" height="30" class="h-7 w-7" />
      Grix
    </a>
    <nav class="hidden gap-7 text-[15px] font-normal text-ash md:flex">
      {
        navItems.map((item) => (
          <a href={item.href} class="transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher currentLocale={currentLocale} currentSlug={currentSlug} />
  </div>
</header>
