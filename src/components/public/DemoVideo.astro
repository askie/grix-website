---
import type { LocaleCode } from "@/i18n/config";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const isChinese = locale === "zh-CN";
---

<section class="mx-auto max-w-6xl px-6 pb-16 pt-6 md:px-12 md:pb-24 md:pt-8">
  <div class="mx-auto max-w-4xl text-center">
    <span class="section-kicker">{isChinese ? "产品演示" : "Product demo"}</span>
    <h2 class="font-display mt-4 text-3xl text-ink md:text-4xl">
      {isChinese ? "观看 Grix 的实际工作方式" : "Watch Grix in action"}
    </h2>
  </div>
  <div class="mt-10 overflow-hidden rounded-card bg-fog shadow-card">
    <video
      controls
      preload="metadata"
      playsinline
      class="aspect-video w-full"
      aria-label={isChinese ? "Grix 产品演示视频" : "Grix product demo video"}
    >
      <source src="/assets/videos/grix-product-hunt-demo-voiceover.mp4" type="video/mp4" />
      {isChinese ? "您的浏览器不支持视频播放。" : "Your browser does not support the video tag."}
    </video>
  </div>
</section>
