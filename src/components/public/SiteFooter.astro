---
import type { LocaleCode } from "@/i18n/config";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const isCN = locale === "zh-CN";
---

<footer class="mt-8 border-t border-black/5 py-12 text-[14px] text-graphite">
  <div class="mx-auto max-w-shell px-4 md:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div>
        <p class="flex items-center gap-2.5 text-[17px] font-semibold text-ink">
          <img src="/assets/brand/app_logo.png" alt="Grix" width="30" height="30" class="h-7 w-7" />
          Grix
        </p>
        <p class="mt-3 max-w-xs leading-[1.5] text-graphite">
          {isCN ? "AI 优先的人类与 Agent 混合即时通讯平台" : "AI-first messaging for humans and agents"}
        </p>
      </div>
      <nav class="flex gap-12">
        <div>
          <p class="font-medium text-ink">{isCN ? "产品" : "Product"}</p>
          <ul class="mt-3 space-y-2.5">
            <li><a href="#features" class="transition-colors hover:text-ink">{isCN ? "核心能力" : "Features"}</a></li>
            <li><a href="#use-cases" class="transition-colors hover:text-ink">{isCN ? "使用场景" : "Use Cases"}</a></li>
            <li><a href="#how-it-works" class="transition-colors hover:text-ink">{isCN ? "怎么开始" : "How it works"}</a></li>
            <li><a href="#faq" class="transition-colors hover:text-ink">{isCN ? "常见问题" : "FAQ"}</a></li>
            <li><a href={isCN ? "/zh-CN/docs" : "/docs"} class="transition-colors hover:text-ink">{isCN ? "用户手册" : "User Guide"}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium text-ink">{isCN ? "开始使用" : "Get started"}</p>
          <ul class="mt-3 space-y-2.5">
            <li><a href="https://grix.im" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">{isCN ? "Web 版" : "Web app"}</a></li>
            <li><a href="https://apps.apple.com/app/grix-ai/id6761908445" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">{isCN ? "iOS 下载" : "iOS"}</a></li>
            <li><a href="https://github.com/askie/grix/releases/latest/download/Grix-Android.apk" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">{isCN ? "Android 下载" : "Android"}</a></li>
            <li><a href="https://github.com/askie/grix/releases/latest" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">{isCN ? "桌面端" : "Desktop"}</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="mt-10 border-t border-black/5 pt-6">
      <p>© {new Date().getFullYear()} Grix</p>
    </div>
  </div>
</footer>
