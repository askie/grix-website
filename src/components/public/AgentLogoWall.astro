---
// Agent logo 墙：展示官网已支持、可接入同一对话协作的主流 AI Agent。
// 仅展示拥有官方 logo 资源的 Agent，保证视觉一致性。
interface Props {
  heading: string;
  description?: string;
}

const { heading, description } = Astro.props;

// 展示用 Agent 列表（name 为对外展示名，logo 为 public 下静态资源路径）。
// 与 aibot 的当前公开清单 (agent_client_type_meta.dart) 对齐。
const agents: { name: string; logo?: string }[] = [
  { name: "OpenClaw", logo: "/assets/agents/openclaw.svg" },
  { name: "Claude", logo: "/assets/agents/anthropic.svg" },
  { name: "Codex", logo: "/assets/agents/openai.svg" },
  { name: "Kimi" },
  { name: "Qwen", logo: "/assets/agents/qwen.svg" },
  { name: "Pi", logo: "/assets/agents/pi.svg" },
  { name: "Hermes", logo: "/assets/agents/hermes.svg" },
  { name: "Reasonix", logo: "/assets/agents/reasonix.svg" },
  { name: "CodeWhale", logo: "/assets/agents/codewhale.svg" },
  { name: "OpenCode", logo: "/assets/agents/opencode.svg" },
  { name: "Kiro", logo: "/assets/agents/kiro.svg" },
  { name: "GitHub Copilot", logo: "/assets/agents/github-copilot.svg" },
  { name: "Antigravity", logo: "/assets/agents/agy.svg" },
  { name: "Cursor", logo: "/assets/agents/cursor.svg" },
  { name: "OpenHuman", logo: "/assets/agents/openhuman.svg" }
];
---

<section class="steep-card p-7 md:p-10">
  <h2 class="text-[26px] font-medium leading-tight text-ink">{heading}</h2>
  {description && <p class="mt-2 max-w-2xl text-[16px] leading-[1.5] text-ash">{description}</p>}
  <ul class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
    {
      agents.map((agent) => (
        <li class="group flex flex-col items-center justify-center gap-2 rounded-2xl border border-black/5 bg-fog px-3 py-5 transition-all hover:bg-white hover:shadow-card">
          {agent.logo ? (
            <img
              src={agent.logo}
              alt={`${agent.name} logo`}
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
              class="h-7 w-7 object-contain opacity-70 grayscale transition group-hover:opacity-100 group-hover:grayscale-0"
            />
          ) : (
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-white text-[11px] font-bold text-graphite">K</span>
          )}
          <span class="text-[12px] font-medium text-graphite transition-colors group-hover:text-ink">
            {agent.name}
          </span>
        </li>
      ))
    }
  </ul>
</section>
