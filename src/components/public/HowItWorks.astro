---
interface Props {
  title: string;
  description: string;
  steps: string[];
}

const { title, description, steps } = Astro.props;
---

<section id="how-it-works" class="steep-card p-7 md:p-10">
  <h2 class="text-[26px] font-medium leading-tight text-ink">{title}</h2>
  <p class="mt-2 max-w-2xl text-[16px] leading-[1.5] text-ash">{description}</p>
  <ol class="mt-8 space-y-5">
    {
      steps.map((step, i) => (
        <li class="flex items-start gap-4">
          <span class="font-display flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-brand-600 text-[15px] text-white">
            {i + 1}
          </span>
          <p class="pt-1 text-[16px] leading-[1.55] text-ash">{step}</p>
        </li>
      ))
    }
  </ol>
</section>
