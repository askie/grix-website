---
interface Props {
  title: string;
  description: string;
  steps: string[];
}

const { title, description, steps } = Astro.props;
---

<section id="how-it-works" class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-slate-900">{title}</h2>
  <p class="mt-2 text-slate-600">{description}</p>
  <ol class="mt-6 space-y-4">
    {
      steps.map((step, i) => (
        <li class="flex items-start gap-4">
          <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white">
            {i + 1}
          </span>
          <p class="pt-1 text-slate-700 leading-6">{step}</p>
        </li>
      ))
    }
  </ol>
</section>
