---
import Icon from "@/components/public/Icon.astro";

interface UseCaseItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  items: UseCaseItem[];
}

const { title, description, items } = Astro.props;
---

<section id="use-cases" class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-slate-900">{title}</h2>
  <p class="mt-2 text-slate-600">{description}</p>
  <ul class="mt-6 grid gap-4 md:grid-cols-2">
    {
      items.map((item) => (
        <li class="flex gap-4 rounded-xl border border-slate-100 p-5 hover:border-brand-200 transition-colors">
          <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <Icon emoji={item.icon} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-1 text-sm text-slate-600 leading-6">{item.desc}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
