---
import Icon from "@/components/public/Icon.astro";

interface UseCaseItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  items: UseCaseItem[];
}

const { title, description, items } = Astro.props;
const washes = ["bg-apricot text-rust", "bg-sky text-ink", "bg-fog text-ink"];
---

<section id="use-cases" class="steep-card p-7 md:p-10">
  <h2 class="text-[26px] font-medium leading-tight text-ink">{title}</h2>
  <p class="mt-2 max-w-2xl text-[16px] leading-[1.5] text-ash">{description}</p>
  <ul class="mt-8 grid gap-4 md:grid-cols-2">
    {
      items.map((item, i) => (
        <li class="flex gap-4 rounded-3xl border border-black/5 bg-white p-6 transition-shadow hover:shadow-card">
          <span class={`flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl ${washes[i % washes.length]}`}>
            <Icon emoji={item.icon} class="h-5 w-5" />
          </span>
          <div>
            <h3 class="text-[17px] font-medium text-ink">{item.title}</h3>
            <p class="mt-1.5 text-[14px] leading-[1.55] text-ash">{item.desc}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
