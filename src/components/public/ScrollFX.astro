---
// Progressive-enhancement "tech" visual layer for public pages:
//  - Lenis buttery smooth scroll (+ cool scan progress bar)
//  - GSAP ScrollTrigger cinematic clip reveals (content untouched)
//  - Three.js cool energy-field + drifting grid that reacts to the cursor
//  - A cursor-reactive particle constellation (the "AI plexus")
// All effects degrade gracefully: no WebGL -> CSS background; reduced-motion
// or missing libs -> content shown instantly. No page copy is modified.
---

<div id="fx-progress" aria-hidden="true"></div>

<style is:global>
  :root { --fx-accent: 230 57 70; } /* 龙虾红 — matches the app theme */

  /* Canvases sit behind everything; white cards keep all text readable. */
  #fx-field, #fx-plexus {
    position: fixed; inset: 0; z-index: -1;
    width: 100%; height: 100%; display: block; pointer-events: none;
  }
  #fx-field { z-index: -2; opacity: 0; transition: opacity 1.4s ease; }
  #fx-field.ready { opacity: 1; }
  #fx-plexus { opacity: 0; transition: opacity 1.6s ease; }
  #fx-plexus.ready { opacity: 1; }

  /* Top scan/progress bar in the cool accent. */
  #fx-progress {
    position: fixed; top: 0; left: 0; height: 2px; width: 0; z-index: 60;
    background: linear-gradient(90deg, #e63946, #a51d2a);
    box-shadow: 0 0 8px rgb(var(--fx-accent) / 0.45);
    transition: width .1s linear;
  }

  /* Tech hover: cool glow ring on the card-like blocks. */
  body main .rounded-xl,
  body main .rounded-panel {
    transition: box-shadow .35s ease, border-color .35s ease, transform .35s ease;
  }
  body main .rounded-xl:hover {
    box-shadow: 0 0 0 1px rgba(23,25,28,0.06),
                0 20px 25px -5px rgba(0,0,0,0.10),
                0 8px 10px -6px rgba(0,0,0,0.10);
  }

  /* No-flash reveal: hide section blocks only once we commit to animating them. */
  html.fx body main > * { opacity: 0; will-change: opacity, transform; }

  /* Lenis */
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-stopped { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    html.fx body main > * { opacity: 1; }
    #fx-field, #fx-plexus { transition: none; }
  }
</style>

<script src="/vendor/lenis.min.js" is:inline></script>
<script src="/vendor/gsap.min.js" is:inline></script>
<script src="/vendor/ScrollTrigger.min.js" is:inline></script>
<script src="/vendor/three.min.js" is:inline></script>
<script is:inline>
(() => {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const gsap = window.gsap, ST = window.ScrollTrigger;

  // Shared, smoothed cursor in normalised coords (0..1, y-down for 2D canvas).
  const pointer = { x: 0.5, y: 0.4, tx: 0.5, ty: 0.4, energy: 0 };
  let lpx = 0.5, lpy = 0.4;
  function onPointer(x, y) {
    const nx = x / window.innerWidth, ny = y / window.innerHeight;
    pointer.energy = Math.min(1, pointer.energy + Math.hypot(nx - lpx, ny - lpy) * 6);
    lpx = nx; lpy = ny; pointer.tx = nx; pointer.ty = ny;
  }
  window.addEventListener('pointermove', e => onPointer(e.clientX, e.clientY), { passive: true });
  window.addEventListener('touchmove', e => { if (e.touches[0]) onPointer(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });

  // ---- 1. Cinematic clip reveals (or fail-safe reveal) ----
  if (reduce || !gsap || !ST) {
    root.classList.remove('fx');
    document.querySelectorAll('main > *').forEach(el => { el.style.opacity = '1'; });
  } else {
    gsap.registerPlugin(ST);
    [...document.querySelectorAll('main > *')].forEach((block) => {
      gsap.set(block, { opacity: 0, y: 46, clipPath: 'inset(0 0 12% 0)' });
      const grid = block.querySelector('.grid');
      const cards = grid ? [...grid.children] : [];
      const tl = gsap.timeline({
        scrollTrigger: { trigger: block, start: 'top 86%', once: true },
        defaults: { ease: 'power4.out' },
      });
      tl.to(block, { opacity: 1, y: 0, clipPath: 'inset(0 0 0% 0)', duration: 0.9 });
      if (cards.length > 1) {
        gsap.set(cards, { y: 24, opacity: 0 });
        tl.to(cards, { y: 0, opacity: 1, duration: 0.55, stagger: 0.07 }, 0.16);
      }
    });
    requestAnimationFrame(() => ST.refresh());
  }

  // ---- 2. Lenis smooth scroll + scan progress bar ----
  let lenis = null;
  const progress = document.getElementById('fx-progress');
  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (progress) progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
  }
  if (window.Lenis && !reduce) {
    lenis = new window.Lenis({ lerp: 0.09, smoothWheel: true });
    lenis.on('scroll', () => { updateProgress(); if (ST) ST.update(); });
    if (gsap && ST) {
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    } else {
      const raf = (t) => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }
    window.lenis = lenis;
    document.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute('href');
      if (id.length > 1 && document.querySelector(id)) {
        e.preventDefault(); lenis.scrollTo(id, { offset: -80, duration: 1.4 });
      }
    });
  } else {
    window.addEventListener('scroll', updateProgress, { passive: true });
  }
  updateProgress();

  // ---- 3. Three.js cool energy-field + drifting grid ----
  (() => {
    const THREE = window.THREE;
    const canvas = document.getElementById('fx-field');
    if (!THREE || !canvas) return;
    let renderer;
    try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true }); }
    catch (e) { return; }
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(DPR);
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const uniforms = {
      uTime: { value: 0 }, uRes: { value: new THREE.Vector2(1, 1) },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) }, uMV: { value: 0 },
    };
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy,0.,1.); }`,
      fragmentShader: `
        precision highp float;
        varying vec2 vUv;
        uniform float uTime, uMV; uniform vec2 uRes, uMouse;
        // cool tech palette on a near-white base
        const vec3 base   = vec3(0.957, 0.969, 0.996);
        const vec3 indigo = vec3(0.392, 0.412, 0.945);
        const vec3 cyan   = vec3(0.180, 0.760, 0.900);
        const vec3 violet = vec3(0.545, 0.380, 0.945);
        float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
        float noise(vec2 p){ vec2 i=floor(p),f=fract(p);
          float a=hash(i),b=hash(i+vec2(1,0)),c=hash(i+vec2(0,1)),d=hash(i+vec2(1,1));
          vec2 u=f*f*(3.-2.*f); return mix(mix(a,b,u.x),mix(c,d,u.x),u.y); }
        float fbm(vec2 p){ float v=0.,a=.5; mat2 m=mat2(1.6,1.2,-1.2,1.6);
          for(int i=0;i<5;i++){ v+=a*noise(p); p=m*p; a*=.5; } return v; }
        // anti-aliased drifting grid
        float grid(vec2 uv, float scale){
          vec2 g = abs(fract(uv*scale - 0.5) - 0.5) / fwidth(uv*scale);
          float l = min(g.x, g.y);
          return 1.0 - min(l, 1.0);
        }
        void main(){
          vec2 uv = vUv;
          float aspect = uRes.x/max(uRes.y,1.0);
          vec2 p = uv; p.x *= aspect;
          vec2 m = uMouse; m.x *= aspect;
          float dM = length(p - m);
          float t = uTime*0.05;
          // flowing cool nebula (subtle)
          vec2 q = vec2(fbm(p*1.6+vec2(0.,t)), fbm(p*1.6+vec2(4.2,-t)));
          vec2 r = vec2(fbm(p*1.6+2.2*q+vec2(1.7,9.2)+t), fbm(p*1.6+2.2*q+vec2(8.3,2.8)-t));
          float f = fbm(p*1.6+3.0*r);
          vec3 col = base;
          col = mix(col, indigo, smoothstep(0.35,0.95,f)*0.16);
          col = mix(col, cyan,   smoothstep(0.55,1.0,length(q))*0.10);
          col = mix(col, violet, smoothstep(0.6,1.0,length(r))*0.10);
          // drifting tech grid, brighter near the cursor
          vec2 guv = uv*vec2(aspect,1.0) + vec2(t*0.15, t*0.08);
          float gl = grid(guv, 26.0)*0.05 + grid(guv, 6.5)*0.05;
          float near = exp(-dM*dM*4.0);
          col = mix(col, indigo, gl*(0.5 + 1.6*near));
          // cursor energy glow
          col += (indigo*0.6 + cyan*0.4) * exp(-dM*dM*7.0) * (0.05 + 0.22*uMV);
          // soft vignette to settle edges
          col = mix(col, base, smoothstep(0.5,1.25,length(uv-0.5))*0.25);
          gl_FragColor = vec4(col, 1.0);
        }
      `,
    });
    scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material));
    function resize(){ const w=window.innerWidth,h=window.innerHeight; renderer.setSize(w,h,false); uniforms.uRes.value.set(w*DPR,h*DPR); }
    window.addEventListener('resize', resize); resize();
    const mv = new THREE.Vector2(0.5, 0.5);
    const clock = new THREE.Clock();
    function frame(){
      const dt = Math.min(clock.getDelta(), 0.05);
      uniforms.uTime.value += reduce ? dt*0.2 : dt;
      mv.set(pointer.x, 1.0 - pointer.y);           // shader uses y-up
      uniforms.uMouse.value.lerp(mv, 0.06);
      uniforms.uMV.value += (pointer.energy - uniforms.uMV.value)*0.1;
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    requestAnimationFrame(() => canvas.classList.add('ready'));
  })();

  // ---- 4. Cursor-reactive particle constellation (AI plexus) ----
  (() => {
    if (reduce) return;
    const canvas = document.getElementById('fx-plexus');
    const ctx = canvas && canvas.getContext('2d');
    if (!ctx) return;
    let w = 0, h = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);
    let pts = [];
    function resize(){
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = w*DPR; canvas.height = h*DPR; ctx.setTransform(DPR,0,0,DPR,0,0);
      const target = Math.min(90, Math.round(w*h/22000));
      pts = Array.from({length: target}, (_, i) => ({
        x: ((i*53)%w), y: ((i*97)%h),                // deterministic spread (no Math.random)
        vx: (((i*7)%5)-2)*0.05, vy: (((i*11)%5)-2)*0.05,
      }));
    }
    window.addEventListener('resize', resize); resize();
    const LINK = 130, ACC = '99,102,241';
    function frame(){
      ctx.clearRect(0,0,w,h);
      const mx = pointer.x*w, my = pointer.y*h;
      for (const a of pts) {
        a.x += a.vx; a.y += a.vy;
        if (a.x<0||a.x>w) a.vx*=-1; if (a.y<0||a.y>h) a.vy*=-1;
        // gentle attraction toward cursor
        const dxm = mx-a.x, dym = my-a.y, dm = Math.hypot(dxm,dym);
        if (dm < 200) { a.x += dxm/dm*0.4; a.y += dym/dm*0.4; }
      }
      for (let i=0;i<pts.length;i++){
        const a = pts[i];
        for (let j=i+1;j<pts.length;j++){
          const b = pts[j];
          const d = Math.hypot(a.x-b.x, a.y-b.y);
          if (d < LINK){
            ctx.strokeStyle = `rgba(${ACC},${(1-d/LINK)*0.16})`;
            ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
          }
        }
        // link to cursor
        const dc = Math.hypot(a.x-mx, a.y-my);
        if (dc < 170){
          ctx.strokeStyle = `rgba(34,211,238,${(1-dc/170)*0.5})`;
          ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(mx,my); ctx.stroke();
        }
        ctx.fillStyle = `rgba(${ACC},0.5)`;
        ctx.beginPath(); ctx.arc(a.x,a.y,1.4,0,6.2832); ctx.fill();
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    requestAnimationFrame(() => canvas.classList.add('ready'));
  })();

  // ---- shared cursor smoothing (drives shader + plexus) ----
  (function smooth(){
    pointer.x += (pointer.tx - pointer.x)*0.12;
    pointer.y += (pointer.ty - pointer.y)*0.12;
    pointer.energy *= 0.94;
    requestAnimationFrame(smooth);
  })();
})();
</script>
