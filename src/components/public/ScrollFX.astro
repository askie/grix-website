---
// Progressive-enhancement visual layer for public pages:
//  - Lenis buttery smooth scroll
//  - GSAP ScrollTrigger cinematic section reveals (content untouched)
//  - A soft, warm, AI-flavoured aurora (Three.js) that reacts to the cursor
// All effects degrade gracefully: no WebGL -> CSS background; reduced-motion
// or missing libs -> content shown instantly. No page copy is modified.
---

<canvas id="fx-aurora" aria-hidden="true"></canvas>

<style is:global>
  /* Aurora sits behind everything; white cards keep all text readable. */
  #fx-aurora {
    position: fixed; inset: 0; z-index: -1;
    width: 100%; height: 100%; display: block;
    opacity: 0; transition: opacity 1.4s ease; pointer-events: none;
  }
  #fx-aurora.ready { opacity: 1; }

  /* No-flash reveal: only hide section blocks once we've committed to animating
     them (html.fx is set synchronously in <head>). Cleared if effects can't run. */
  html.fx body main > * { opacity: 0; will-change: opacity, transform; }

  /* Lenis */
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-stopped { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    html.fx body main > * { opacity: 1; }
    #fx-aurora { transition: none; }
  }
</style>

<script src="/vendor/lenis.min.js" is:inline></script>
<script src="/vendor/gsap.min.js" is:inline></script>
<script src="/vendor/ScrollTrigger.min.js" is:inline></script>
<script src="/vendor/three.min.js" is:inline></script>
<script is:inline>
(() => {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const gsap = window.gsap, ST = window.ScrollTrigger;

  // ---- 1. Cinematic section reveals (or fail-safe reveal) ----
  function revealInstant() {
    root.classList.remove('fx');
    document.querySelectorAll('main > *').forEach(el => { el.style.opacity = '1'; });
  }
  if (reduce || !gsap || !ST) {
    revealInstant();
  } else {
    gsap.registerPlugin(ST);
    const blocks = [...document.querySelectorAll('main > *')];
    blocks.forEach((block) => {
      gsap.set(block, { opacity: 0, y: 48, filter: 'blur(8px)' });
      const grid = block.querySelector('.grid');
      const cards = grid ? [...grid.children] : [];
      const tl = gsap.timeline({
        scrollTrigger: { trigger: block, start: 'top 86%', once: true },
        defaults: { ease: 'power3.out' },
      });
      tl.to(block, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9 });
      if (cards.length > 1) {
        gsap.set(cards, { y: 22, opacity: 0 });
        tl.to(cards, { y: 0, opacity: 1, duration: 0.6, stagger: 0.08 }, 0.18);
      }
    });
    // Reveal whatever is already on screen at load.
    requestAnimationFrame(() => ST.refresh());
  }

  // ---- 2. Lenis smooth scroll, driven by the GSAP ticker ----
  let lenis = null;
  if (window.Lenis && !reduce) {
    lenis = new window.Lenis({ lerp: 0.09, smoothWheel: true });
    if (gsap && ST) {
      lenis.on('scroll', ST.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    } else {
      const raf = (t) => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }
    window.lenis = lenis;
    // Smooth in-page anchor jumps (header nav etc.)
    document.addEventListener('click', (e) => {
      const a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute('href');
      if (id.length > 1 && document.querySelector(id)) {
        e.preventDefault(); lenis.scrollTo(id, { offset: -80, duration: 1.4 });
      }
    });
  }

  // ---- 3. Warm AI aurora background (Three.js) ----
  (() => {
    const THREE = window.THREE;
    const canvas = document.getElementById('fx-aurora');
    if (!THREE || !canvas) return;
    let renderer;
    try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true }); }
    catch (e) { return; }

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(DPR);
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const uniforms = {
      uTime:  { value: 0 },
      uRes:   { value: new THREE.Vector2(1, 1) },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
      uMV:    { value: 0 },
    };
    const material = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy,0.,1.); }`,
      fragmentShader: `
        precision highp float;
        varying vec2 vUv;
        uniform float uTime, uMV; uniform vec2 uRes, uMouse;
        // warm pastel palette
        const vec3 cream = vec3(0.992,0.976,0.937);
        const vec3 peach = vec3(1.000,0.860,0.835);
        const vec3 gold  = vec3(1.000,0.918,0.804);
        const vec3 rose  = vec3(1.000,0.815,0.842);
        const vec3 brand = vec3(0.918,0.443,0.388);
        float hash(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32); return fract(p.x*p.y); }
        float noise(vec2 p){ vec2 i=floor(p),f=fract(p);
          float a=hash(i),b=hash(i+vec2(1,0)),c=hash(i+vec2(0,1)),d=hash(i+vec2(1,1));
          vec2 u=f*f*(3.-2.*f); return mix(mix(a,b,u.x),mix(c,d,u.x),u.y); }
        float fbm(vec2 p){ float v=0.,a=.5; mat2 m=mat2(1.6,1.2,-1.2,1.6);
          for(int i=0;i<5;i++){ v+=a*noise(p); p=m*p; a*=.5; } return v; }
        void main(){
          vec2 uv = vUv;
          float aspect = uRes.x/max(uRes.y,1.0);
          vec2 p = uv; p.x *= aspect;
          vec2 m = uMouse; m.x *= aspect;
          vec2 toM = p - m; float dM = length(toM);
          float infl = exp(-dM*dM*6.0);
          float ang = (0.5 + 1.1*uMV) * infl;
          float s=sin(ang),c=cos(ang);
          p += (mat2(c,-s,s,c)*toM - toM) * 0.5;

          float t = uTime*0.04;
          vec2 q = vec2(fbm(p*1.7+vec2(0.,t)), fbm(p*1.7+vec2(4.2,-t)));
          vec2 r = vec2(fbm(p*1.7+2.4*q+vec2(1.7,9.2)+t), fbm(p*1.7+2.4*q+vec2(8.3,2.8)-t));
          float f = fbm(p*1.7+3.0*r);

          // soft warm wash, mostly cream with peach/gold/rose drifting through
          vec3 col = mix(cream, peach, smoothstep(0.2,0.9,f));
          col = mix(col, gold,  smoothstep(0.4,1.0,length(q))*0.6);
          col = mix(col, rose,  smoothstep(0.55,1.0,length(r))*0.5);
          // faint brand-coloured veins, very restrained
          col = mix(col, brand, pow(f,4.0)*0.10);
          // gentle light that follows the cursor
          col += vec3(1.0,0.97,0.94) * exp(-dM*dM*9.0) * (0.05 + 0.18*uMV);

          // keep the top-right glow the site already has
          float corner = smoothstep(1.1,0.1,length(uv-vec2(0.95,0.05)));
          col = mix(col, mix(col,rose,0.5), corner*0.35);

          gl_FragColor = vec4(col, 1.0);
        }
      `,
    });
    scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2,2), material));

    function resize(){
      const w = window.innerWidth, h = window.innerHeight;
      renderer.setSize(w, h, false);
      uniforms.uRes.value.set(w*DPR, h*DPR);
    }
    window.addEventListener('resize', resize); resize();

    const target = new THREE.Vector2(0.5, 0.5);
    let energy = 0, lx = 0.5, ly = 0.5;
    function point(x, y){
      const nx = x/window.innerWidth, ny = 1 - y/window.innerHeight;
      energy = Math.min(1, energy + Math.hypot(nx-lx, ny-ly)*6);
      lx = nx; ly = ny; target.set(nx, ny);
    }
    window.addEventListener('pointermove', e => point(e.clientX, e.clientY), { passive: true });

    const clock = new THREE.Clock();
    function frame(){
      const dt = Math.min(clock.getDelta(), 0.05);
      uniforms.uTime.value += reduce ? dt*0.2 : dt;
      uniforms.uMouse.value.lerp(target, 0.06);
      energy *= 0.94;
      uniforms.uMV.value += (energy - uniforms.uMV.value)*0.1;
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    requestAnimationFrame(() => canvas.classList.add('ready'));
  })();
})();
</script>
