---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  href: string;
}

const { title, description, buttonText, href } = Astro.props;
---

<section class="rounded-panel border border-brand-100 bg-brand-50 p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-brand-700">{title}</h2>
  <p class="mt-2 max-w-3xl text-slate-700">{description}</p>
  <a href={href} class="mt-5 inline-block rounded-full bg-brand-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-700">
    {buttonText}
  </a>
</section>
