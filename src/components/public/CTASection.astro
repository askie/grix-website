---
import Icon from "@/components/public/Icon.astro";
import type { LocaleCode } from "@/i18n/config";

interface Props {
  title: string;
  description: string;
  buttonText: string;
  href: string;
  locale: LocaleCode;
}

const { locale } = Astro.props;
const isCN = locale === "zh-CN";

const platforms = [
  {
    name: "iOS",
    label: "iOS (App Store)",
    href: "https://apps.apple.com/app/grix-ai/id6761908445",
    icon: "apple",
  },
  {
    name: "Android",
    label: "Android",
    href: "https://github.com/askie/grix/releases/latest/download/Grix-Android.apk",
    icon: "android",
  },
  {
    name: "macOS",
    label: "macOS",
    href: "https://github.com/askie/grix/releases/latest/download/Grix-macOS.zip",
    icon: "apple",
  },
  {
    name: "Windows",
    label: "Windows",
    href: "https://github.com/askie/grix/releases/latest/download/Grix-Windows.zip",
    icon: "windows",
  },
  {
    name: "Linux",
    label: "Linux",
    href: "https://github.com/askie/grix/releases/latest/download/Grix-Linux-x64.tar.gz",
    icon: "linux",
  },
  {
    name: "Web",
    label: "Web",
    href: "https://grix.im",
    icon: "globe",
  },
];

const iosAppStoreUrl = "https://apps.apple.com/app/grix-ai/id6761908445";
const androidApkUrl =
  "https://github.com/askie/grix/releases/latest/download/Grix-Android.apk";
const iosQrUrl = "/qr/ios.svg";
const androidQrUrl = "/qr/android.svg";
---

<section class="steep-card overflow-hidden p-7 md:p-10" style="background:#fbe1d1;">
  <h2 class="font-display text-[2rem] leading-tight text-rust md:text-[2.5rem]">
    {isCN ? "随时随地，开始使用" : "Start anywhere"}
  </h2>
  <p class="mt-2 max-w-2xl text-[16px] leading-[1.5] text-rust/75">
    {isCN
      ? "支持 iOS、Android、macOS、Windows、Linux 和 Web。"
      : "Available on iOS, Android, macOS, Windows, Linux, and Web."}
  </p>

  <div class="mt-7 flex flex-col gap-6 md:flex-row md:items-start">
    <!-- QR Codes -->
    <div class="grid grid-cols-2 gap-4 sm:flex">
      <div class="flex min-w-0 flex-col items-center gap-2 rounded-3xl bg-white p-4 shadow-card">
        <a href={iosAppStoreUrl} target="_blank" rel="noopener noreferrer" class="block w-full max-w-[140px]">
          <img src={iosQrUrl} alt="App Store QR Code" class="aspect-square h-auto w-full object-contain" />
        </a>
        <span class="text-[12px] text-graphite">
          {isCN ? "扫码下载 iOS" : "Scan for iOS"}
        </span>
      </div>
      <div class="flex min-w-0 flex-col items-center gap-2 rounded-3xl bg-white p-4 shadow-card">
        <a href={androidApkUrl} target="_blank" rel="noopener noreferrer" class="block w-full max-w-[140px]">
          <img src={androidQrUrl} alt="Android QR Code" class="aspect-square h-auto w-full object-contain" />
        </a>
        <span class="text-[12px] text-graphite">
          {isCN ? "扫码下载 Android" : "Scan for Android"}
        </span>
      </div>
    </div>

    <!-- Platform download links -->
    <div class="grid flex-1 grid-cols-2 gap-3 sm:grid-cols-3">
      {platforms.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-2 rounded-2xl bg-white/70 px-4 py-3 text-[14px] font-medium text-ink ring-1 ring-rust/10 transition-all hover:bg-white hover:shadow-card"
        >
          <Icon name={p.icon} class="h-5 w-5 flex-shrink-0 text-rust/70 transition-colors group-hover:text-rust" />
          {p.label}
        </a>
      ))}
    </div>
  </div>
</section>
