---
import Icon from "@/components/public/Icon.astro";

interface FeatureItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  items: FeatureItem[];
}

const { title, description, items } = Astro.props;
// Rotate the three Steep washes across icon chips for warmth without saturation.
const washes = ["bg-fog text-ink", "bg-apricot text-rust", "bg-sky text-ink"];
---

<section id="features" class="steep-card p-7 md:p-10">
  <h2 class="text-[26px] font-medium leading-tight text-ink">{title}</h2>
  <p class="mt-2 max-w-2xl text-[16px] leading-[1.5] text-ash">{description}</p>
  <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item, i) => (
        <li class="rounded-3xl border border-black/5 bg-white p-6 transition-shadow hover:shadow-card">
          <div class={`mb-4 inline-flex h-11 w-11 items-center justify-center rounded-2xl ${washes[i % washes.length]}`}>
            <Icon emoji={item.icon} class="h-5 w-5" />
          </div>
          <h3 class="text-[17px] font-medium text-ink">{item.title}</h3>
          <p class="mt-1.5 text-[14px] leading-[1.55] text-ash">{item.desc}</p>
        </li>
      ))
    }
  </ul>
</section>
