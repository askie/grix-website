---
import Icon from "@/components/public/Icon.astro";

interface FeatureItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  items: FeatureItem[];
}

const { title, description, items } = Astro.props;
---

<section id="features" class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-slate-900">{title}</h2>
  <p class="mt-2 text-slate-600">{description}</p>
  <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <li class="rounded-xl border border-slate-100 bg-slate-50 p-5 hover:border-brand-200 hover:bg-brand-50 transition-colors">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon emoji={item.icon} class="h-5 w-5" />
          </div>
          <h3 class="font-semibold text-slate-900 text-sm">{item.title}</h3>
          <p class="mt-1 text-sm text-slate-600 leading-6">{item.desc}</p>
        </li>
      ))
    }
  </ul>
</section>
