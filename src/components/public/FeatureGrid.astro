---
interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items } = Astro.props;
---

<section id="features" class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
  <h2 class="text-2xl font-semibold text-slate-900">{title}</h2>
  <p class="mt-2 text-slate-600">{description}</p>
  <ul class="mt-5 grid gap-3 md:grid-cols-2">
    {items.map((item) => <li class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-700">{item}</li>)}
  </ul>
</section>
