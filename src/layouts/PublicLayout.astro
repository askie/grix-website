---
import SiteHeader from "@/components/public/SiteHeader.astro";
import SiteFooter from "@/components/public/SiteFooter.astro";
import ScrollFX from "@/components/public/ScrollFX.astro";
import { buildAlternates } from "@/lib/seo/meta";
import { defaultLocale, type LocaleCode } from "@/i18n/config";
import { resolvePool, resolveWidget } from "@/lib/widget/config";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  slug?: string;
  noindex?: boolean;
}

const { title, description, locale = defaultLocale, slug = "", noindex = false } = Astro.props;
const alternates = buildAlternates(slug);
const canonicalBase = "https://grix.pub";
const canonicalPath = locale === defaultLocale ? `/${slug}` : `/${locale}/${slug}`;
const canonical = `${canonicalBase}${canonicalPath}`.replace(/\/$/, "") || canonicalBase;

// Resolve the grix widget for this deploy target: CF_POOL env var wins, else
// the request hostname, else the default pool. Falls back gracefully when the
// Cloudflare runtime env is unavailable (e.g. local astro dev).
let envPool: string | null = null;
try {
  envPool = (Astro.locals as any)?.runtime?.env?.CF_POOL ?? import.meta.env.CF_POOL ?? null;
} catch {
  envPool = null;
}
const widget = resolveWidget(resolvePool({ envPool, hostname: Astro.url?.hostname }), locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Grix" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- hreflang alternates -->
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
      ))
    }
    <!-- Mark the doc for the no-flash reveal before first paint (skips reduced-motion). -->
    <script is:inline>
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('fx');
        }
      } catch (e) {}
    </script>
    <script src={widget.src} data-site-key={widget.siteKey} defer is:inline></script>
  </head>
  <body class="main-shell font-sans text-slate-900">
    <SiteHeader currentLocale={locale} currentSlug={slug} />
    <main class="mx-auto max-w-6xl space-y-8 px-4 py-8 md:px-6 md:py-12">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <ScrollFX />
    {locale === defaultLocale && (
      <script is:inline>
        (function () {
          var KEY = 'grix_locale';
          if (localStorage.getItem(KEY)) return;
          var lang = navigator.language || '';
          if (lang.startsWith('zh')) {
            localStorage.setItem(KEY, 'zh-CN');
            var slug = location.pathname === '/' ? '' : location.pathname;
            location.replace('/zh-CN' + slug + location.search);
          }
        })();
      </script>
    )}
  </body>
</html>
