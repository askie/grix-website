---
import PublicLayout from "@/layouts/PublicLayout.astro";
import ProductHomePage from "@/templates/ProductHomePage.astro";
import { defaultLocale } from "@/i18n/config";

const title = "Grix — DeepSeek Harness for Mobile and Desktop";
const description =
  "Talk to DeepSeek Harness and other coding agents like colleagues. Start on desktop, continue from your phone, and keep messages, files, progress, and approvals in one shared thread.";
---

<PublicLayout title={title} description={description} locale={defaultLocale}>
  <ProductHomePage locale={defaultLocale} />
</PublicLayout>
