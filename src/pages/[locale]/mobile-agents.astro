---
import PublicLayout from "@/layouts/PublicLayout.astro";
import MobileAgentsPage from "@/templates/MobileAgentsPage.astro";
import { defaultLocale, isSupportedLocale } from "@/i18n/config";

const rawLocale = Astro.params.locale;
const invalidLocale = !rawLocale || !isSupportedLocale(rawLocale);
const locale = invalidLocale ? defaultLocale : rawLocale;
const isCN = locale === "zh-CN";
const slug = "mobile-agents";

if (invalidLocale) {
  Astro.response.status = 404;
}
---

{
  invalidLocale ? (
    <PublicLayout title="Page not found" description="Requested page was not found." locale={locale} noindex>
      <section class="rounded-panel border border-slate-200 bg-white p-8">
        <h1 class="text-2xl font-semibold">Page not found</h1>
      </section>
    </PublicLayout>
  ) : (
    <PublicLayout
      title={isCN ? "Grix 移动端 Agent 控制台：用手机指挥 Claude 和 Codex" : "Grix Mobile Agent Control for Claude and Codex"}
      description={
        isCN
          ? "用 Grix 在手机上控制 Claude、Codex 和协作开发流程，邀请同事参与评审，审批关键决策，让桌面端 Agent 持续工作。"
          : "Use Grix to control Claude, Codex, and collaborative agent work from your phone. Invite teammates, approve decisions, and keep desktop agents moving."
      }
      locale={locale}
      slug={slug}
    >
      <MobileAgentsPage locale={locale} />
    </PublicLayout>
  )
}
