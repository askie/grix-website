---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { defaultLocale } from "@/i18n/config";
import { getPublishedPageBySlug } from "@/lib/content-mapper/repository";
import HomePage from "@/templates/HomePage.astro";
import LandingPage from "@/templates/LandingPage.astro";

const slug = Astro.params.slug ?? "";
const page = getPublishedPageBySlug(defaultLocale, slug);

if (!page) {
  Astro.response.status = 404;
}
---

{
  page ? (
    <PublicLayout title={page.seoTitle} description={page.seoDescription} locale={defaultLocale} slug={slug}>
      {slug === "" ? <HomePage locale={defaultLocale} page={page} /> : <LandingPage page={page} />}
    </PublicLayout>
  ) : (
    <PublicLayout title="页面不存在" description="请求页面不存在。" locale={defaultLocale} noindex>
      <section class="rounded-panel border border-slate-200 bg-white p-8">
        <h1 class="text-2xl font-semibold">页面不存在</h1>
      </section>
    </PublicLayout>
  )
}
