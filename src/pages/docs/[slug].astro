---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getCollection, render } from "astro:content";
import { defaultLocale } from "@/i18n/config";

const locale = defaultLocale;
const prefix = `${locale.toLowerCase()}/`;
const { slug } = Astro.params;
const allDocs = await getCollection("docs");
const docs = allDocs
  .filter((d) => d.id.startsWith(prefix))
  .sort((a, b) => a.data.order - b.data.order);

const docId = `${prefix}${slug}`;
const doc = docs.find((d) => d.id === docId);

if (!doc) {
  return Astro.redirect("/docs");
}

const { Content } = await render(doc);
const currentIndex = docs.findIndex((d) => d.id === doc.id);
const prev = currentIndex > 0 ? docs[currentIndex - 1] : null;
const next = currentIndex < docs.length - 1 ? docs[currentIndex + 1] : null;

const slugOnly = doc.id.replace(prefix, "");
---

<PublicLayout
  title={`${doc.data.title} - Grix Docs`}
  description={doc.data.description}
  locale={locale}
  slug={`docs/${slugOnly}`}
>
  <nav class="text-sm text-slate-500 mb-4">
    <a href="/" class="hover:text-brand-600">Home</a>
    <span class="mx-1">/</span>
    <a href="/docs" class="hover:text-brand-600">Docs</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700">{doc.data.title}</span>
  </nav>

  <article class="rounded-panel border border-slate-200 bg-white p-6 md:p-8 prose prose-slate max-w-none">
    <h1 class="text-3xl font-semibold text-slate-900 mb-2">{doc.data.title}</h1>
    <p class="text-slate-500 text-base mb-8 not-prose">{doc.data.description}</p>
    <Content />
  </article>

  <nav class="flex justify-between mt-6 text-sm">
    {prev ? (
      <a href={`/docs/${prev.id.replace(prefix, "")}`} class="text-brand-600 hover:underline">← {prev.data.title}</a>
    ) : <span />}
    {next ? (
      <a href={`/docs/${next.id.replace(prefix, "")}`} class="text-brand-600 hover:underline">{next.data.title} →</a>
    ) : <span />}
  </nav>
</PublicLayout>
