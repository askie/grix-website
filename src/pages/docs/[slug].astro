---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getCollection, render } from "astro:content";

const { slug } = Astro.params;
const docs = await getCollection("docs");
const doc = docs.find((d) => d.id === slug);

if (!doc) {
  return Astro.redirect("/docs");
}

const { Content } = await render(doc);
const sorted = docs.sort((a, b) => a.data.order - b.data.order);
const currentIndex = sorted.findIndex((d) => d.id === doc.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<PublicLayout
  title={`${doc.data.title} - Grix 用户手册`}
  description={doc.data.description}
  locale="zh-CN"
  slug={`docs/${doc.id}`}
>
  <nav class="text-sm text-slate-500 mb-4">
    <a href="/" class="hover:text-blue-600">首页</a>
    <span class="mx-1">/</span>
    <a href="/docs" class="hover:text-blue-600">用户手册</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700">{doc.data.title}</span>
  </nav>

  <article class="rounded-panel border border-slate-200 bg-white p-6 md:p-8 prose prose-slate max-w-none">
    <h1 class="text-3xl font-semibold text-slate-900 mb-2">{doc.data.title}</h1>
    <p class="text-slate-500 text-base mb-8 not-prose">{doc.data.description}</p>
    <Content />
  </article>

  <nav class="flex justify-between mt-6 text-sm">
    {prev ? (
      <a href={`/docs/${prev.id}`} class="text-blue-600 hover:underline">← {prev.data.title}</a>
    ) : <span />}
    {next ? (
      <a href={`/docs/${next.id}`} class="text-blue-600 hover:underline">{next.data.title} →</a>
    ) : <span />}
  </nav>
</PublicLayout>
