---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getCollection } from "astro:content";

const docs = await getCollection("docs");
const sorted = docs.sort((a, b) => a.data.order - b.data.order);
---

<PublicLayout
  title="Grix 用户手册 - 帮助文档"
  description="Grix 用户操作手册，涵盖产品概述、快速开始、多 Agent 编排、聊天、语音通话、安全等全面指南。"
  locale="zh-CN"
  slug="docs"
>
  <nav class="text-sm text-slate-500 mb-4">
    <a href="/" class="hover:text-blue-600">首页</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700">用户手册</span>
  </nav>

  <section class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
    <h1 class="text-3xl font-semibold text-slate-900 mb-2">Grix 用户手册</h1>
    <p class="text-slate-500 mb-8">多 Agent 编排工作台，人与 AI 无缝协作的即时通讯平台。</p>

    <ul class="space-y-3">
      {sorted.map((doc) => (
        <li>
          <a href={`/docs/${doc.id}`} class="group block rounded-lg border border-slate-100 p-4 hover:border-blue-200 hover:bg-blue-50/50 transition-colors">
            <h2 class="text-lg font-medium text-slate-800 group-hover:text-blue-600">{doc.data.title}</h2>
            <p class="text-sm text-slate-500 mt-1">{doc.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</PublicLayout>
