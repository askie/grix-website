---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getCollection } from "astro:content";
import { defaultLocale } from "@/i18n/config";

const locale = defaultLocale;
const prefix = `${locale.toLowerCase()}/`;
const allDocs = await getCollection("docs");
const docs = allDocs
  .filter((d) => d.id.startsWith(prefix))
  .sort((a, b) => a.data.order - b.data.order);
---

<PublicLayout title="Grix Docs - User Guide" description="Complete guide to Grix — product overview, quick start, multi-agent orchestration, chat, voice calls, security, and more." locale={locale} slug="docs">
  <nav class="text-sm text-slate-500 mb-4">
    <a href="/" class="hover:text-brand-600">Home</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700">Docs</span>
  </nav>

  <section class="rounded-panel border border-slate-200 bg-white p-6 md:p-8">
    <h1 class="text-3xl font-semibold text-slate-900 mb-2">Grix Docs</h1>
    <p class="text-slate-500 mb-8">AI-first messaging for humans and agents. Multi-agent orchestration workbench.</p>

    <ul class="space-y-3">
      {docs.map((doc) => {
        const slug = doc.id.replace(prefix, "");
        return (
          <li>
            <a href={`/docs/${slug}`} class="group block rounded-lg border border-slate-100 p-4 hover:border-brand-100 hover:bg-brand-50/50 transition-colors">
              <h2 class="text-lg font-medium text-slate-800 group-hover:text-brand-600">{doc.data.title}</h2>
              <p class="text-sm text-slate-500 mt-1">{doc.data.description}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</PublicLayout>
